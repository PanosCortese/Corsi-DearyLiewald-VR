  m_text: "\u039A\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03C5 \u0395\u039D\u0391
    \u03B1\u03C0\u03CC \u03C4\u03B1 \u03A4\u0395\u03A3\u03A3\u0395\u03A1\u0391 \u03BA\u03BF\u03C5\u03C4\u03B9\u03AC
    \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u039C\u03A0\u039B\u0395, \u03C4\u03CC\u03C4\u03B5
    \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03B1\u03B3\u03B3\u03AF\u03BE\u03B5\u03C4\u03B5. 
    \u039D\u03B1 \u03B8\u03C5\u03BC\u03AC\u03C3\u03C4\u03B5 \u03CC\u03C4\u03B9 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
    \u03BD\u03B1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03CC\u03C3\u03BF \u03C4\u03BF \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03BD
    \u03C0\u03B9\u03BF \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.  \u039F\u03B9
    \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B5\u03C2 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2 \u03B5\u03BE\u03AC\u03C3\u03BA\u03B7\u03C3\u03B7."
