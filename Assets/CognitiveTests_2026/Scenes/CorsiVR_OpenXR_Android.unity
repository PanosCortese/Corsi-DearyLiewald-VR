  LeftNotes: {fileID: 1499801170}
  RightNotes: {fileID: 755830948}
  text1: {fileID: 539053266}
  text2: {fileID: 565305389}
  text3: {fileID: 2008424622}
  text4: {fileID: 1957724923}
  text5: {fileID: 2110486439}
  text6: {fileID: 40984707}
  text7: {fileID: 755748058}
  text8: {fileID: 1987700663}
  text9: {fileID: 1453739359}
  text10: {fileID: 48738386}
  quest1: CYBERSICKNESS QUESTIONNAIRE
  quest2: 'Touch the number on the slider that corresponds to your response. '
  quest3: Touch the NEXT button to confirm your response.
  quest4: 'Touch the BACK button to go to the previous question. '
  quest5: Touch the DONE button to finish the questionnaire.
  digitF1: Digits Recall - FORWARD
  digitF2: 'You need to indicate the numbers in SAME order. '
  digitF3: 'Touch the respective button for 1 second to select it. '
  digitF4: Green = Correct and Orange = False
  digitF5: 'Every second round the quantity of numbers will be increasing by one. '
  digit1: Digits Recall - BACKWARD
  digit2: 'You need to indicate the numbers in SAME order. '
  digit3: 'Touch the respective button for 1 second to select it. '
  digit4: Green = Correct and Orange = False
  digit5: 'Every second round the quantity of numbers will be increasing by one. '
  corsiF1: Corsi Blocks Recall - FORWARD
  corsiF2: 'You need to indicate the cubes in SAME order. '
  corsiF3: 'Touch the respective cube for 1 second to select it. '
  corsiF4: Green = Correct and Orange = False
  corsiF5: 'Every second round the quantity of cubes will be increasing by one. '
  corsi1: Corsi Blocks Recall - BACKWARD
  corsi2: 'You need to indicate the cubes in REVERSE order. '
  corsi3: 'Touch the respective cube for 1 second to select it. '
  corsi4: Green = Correct and Orange = False
  corsi5: 'Every second round the quantity of cubes will be increasing by one. '
  deary1: PSYCHOMOTOR SKILLS
  deary2: 'Whenever a cube turns blue, you need to touch it as fast as possible. '
  deary3: By touching it, you immediately select the cube.
  deary4: When you have selected it, return your hand close to your body.
  deary5: "The interval times between each target\u2019s presentation vary. "
